# MirageForge Environment Configuration
# Copy this file to .env and customize for your environment
# DO NOT commit .env to version control

# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-string-in-production
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./mirageforge.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/mirageforge

# Admin
ADMIN_TOKEN=change-this-to-a-strong-token-or-leave-empty-to-disable
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Server
HOST=0.0.0.0
PORT=8000

# Experiment
DEFAULT_STUDY_ID=1
TRIALS_PER_SESSION=12

# Optional: ML Models
# Set to 'true' to enable CLIP backend (requires torch and transformers)
ENABLE_CLIP_BACKEND=false
CLIP_MODEL_NAME=openai/clip-vit-base-patch32

# Rate Limiting (requests per minute per session)
RATE_LIMIT_RPM=100

# Security
CSRF_SECRET=change-this-to-a-random-string
SESSION_COOKIE_NAME=mirageforge_session
SESSION_COOKIE_SECURE=false
# Set to 'true' in production with HTTPS
